
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 Hi, I'm Manish!</h1>

			<p>
				Welcome to my personal website. I'm Manish, and this is where I
				share a little about myself, my interests, projects, and things
				I learn along the way.
			</p>

			<p>
				I enjoy exploring new ideas, learning new things, and working
				on projects that interest me.
			</p>

			<p>
				Here, you'll find my projects, thoughts, experiences, and
				occasional updates about what I'm working on.
			</p>

			<p>
				Thanks for visiting. Feel free to explore!
			</p>
		</main>
		<Footer />
	</body>
</html>
